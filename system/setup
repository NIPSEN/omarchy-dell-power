#!/usr/bin/python3 -I
"""Root-installed setup allowlist; no hardware access or caller paths."""

import os
import pwd
import re
import subprocess
import sys
import tempfile
from pathlib import Path

AUTH = Path("/etc/sudoers.d/dell-power-extension")
POLICY = Path("/usr/share/polkit-1/actions/local.dell-power-extension.policy")
POLICY_SOURCE = Path("/usr/lib/dell-power-extension/control.policy")
ENV = {"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"}
MARK = "# Owned by local.dell-power-extension\n"


def owned():
    if AUTH.is_symlink():
        raise ValueError("Refusing symlink authorization")
    if AUTH.exists() and not AUTH.read_text().startswith(MARK):
        raise ValueError("Unrelated authorization occupies installer path")
    if POLICY.is_symlink():
        raise ValueError("Refusing symlink polkit action")
    if (
        POLICY.exists()
        and 'action id="local.dell-power-extension.control"' not in POLICY.read_text()
    ):
        raise ValueError("Unrelated polkit action occupies installer path")


def main(args):
    if os.geteuid() != 0:
        raise ValueError("Setup requires root")
    if (
        len(args) != 2
        or args[0] not in {"authorize", "revoke"}
        or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", args[1])
    ):
        raise ValueError("Usage: setup authorize|revoke USER")
    user = pwd.getpwnam(args[1])
    if user.pw_uid == 0:
        raise ValueError("Desktop user must be unprivileged")
    owned()
    if args[0] == "revoke":
        if AUTH.exists():
            AUTH.unlink()
        if POLICY.exists():
            POLICY.unlink()
        return
    helper = Path("/usr/lib/dell-power-extension/control")
    for path in (helper, helper.parent / "backend.py", helper.parent, POLICY_SOURCE):
        info = path.stat()
        if info.st_uid != 0 or info.st_mode & 0o022 or path.is_symlink():
            raise ValueError(
                "Privileged payload must be root-owned and not writable by other users"
            )
    # Helper validates operation/args internally. Passwordless grant is scoped
    # to exactly one root-owned executable, never an interpreter or setup.
    rule = MARK + f"{user.pw_name} ALL=(root) NOPASSWD: {helper}\n"
    fd, name = tempfile.mkstemp(prefix=".dell-power-extension-", dir=AUTH.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            os.fchmod(stream.fileno(), 0o440)
            stream.write(rule)
            stream.flush()
            os.fsync(stream.fileno())
        subprocess.run(
            ["/usr/bin/visudo", "-cf", name],
            check=True,
            env=ENV,
            timeout=10,
            stdin=subprocess.DEVNULL,
        )
        # Package stores an inert template. Authorization is activated only
        # after compatible root-owned helper artifacts have been installed.
        policy_fd, policy_name = tempfile.mkstemp(
            prefix=".dell-power-extension-", dir=POLICY.parent
        )
        try:
            with os.fdopen(policy_fd, "wb") as stream:
                os.fchmod(stream.fileno(), 0o644)
                stream.write(POLICY_SOURCE.read_bytes())
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(policy_name, POLICY)
        finally:
            if os.path.exists(policy_name):
                os.unlink(policy_name)
        os.replace(name, AUTH)
    finally:
        if os.path.exists(name):
            os.unlink(name)


if __name__ == "__main__":
    os.environ.clear()
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
