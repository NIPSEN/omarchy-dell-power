#!/usr/bin/python3 -I
"""Installed fixed-path CLI. Never activates test seams from environment/args."""

import json
import os
import signal
import sys
import syslog
from pathlib import Path

# -I excludes cwd/PYTHONPATH/user site. Installed as
# /usr/local/bin/dell-charge-limit, the backend is the root-owned
# /usr/local/lib/dell-power/backend.py; in a checkout it is the sibling file.
HERE = Path(__file__).resolve().parent
LIB = HERE if (HERE / "backend.py").is_file() else Path("/usr/local/lib/dell-power")
sys.path.insert(0, str(LIB))
sys.dont_write_bytecode = True
from backend import PROTOCOL_VERSION, Controller, Hardware, Refused


def deadline(signum, frame):
    raise Refused("Operation exceeded deadline")


def audit(event, args, result=None):
    """Record setting transactions, without flooding the journal with polls."""
    if not args or args[0] in {"status", "status-live", "sensors", "transaction-state", "power-chain"}:
        return
    record = {"event": event, "operation": args[0][:64]}
    if event == "start":
        record["requested"] = [arg[:64] for arg in args[1:3]]
    if result is not None:
        for key in ("ok", "applied", "error", "rollback"):
            if key in result:
                record[key] = result[key]
        for key in ("before", "actual"):
            value = result.get(key) or {}
            record[key] = {field: value.get(field) for field in ("ppd", "thermal", "controllers", "thresholds", "wmi")}
    try:
        syslog.openlog("dell-power", syslog.LOG_PID, syslog.LOG_USER)
        syslog.syslog(syslog.LOG_INFO, json.dumps(record, separators=(",", ":"))[:8192])
    except OSError:
        pass  # Journal availability must not change a hardware transaction.


if __name__ == "__main__":
    signal.signal(signal.SIGALRM, deadline)
    signal.alarm(45)
    os.environ.clear()
    os.environ.update(PATH="/usr/bin:/bin", LANG="C", LC_ALL="C")
    read_ops = {"status", "status-live", "sensors", "transaction-state"}
    try:
        snapshot_restore = len(sys.argv) == 4 and sys.argv[1] == "profile-restore-state"
        snapshot_apply = len(sys.argv) == 5 and sys.argv[1] == "profile-owned-state"
        if len(sys.argv) > 8 or any(
            len(arg)
            > (
                8192
                if (snapshot_restore and i > 1) or (snapshot_apply and i == 4)
                else 64
            )
            for i, arg in enumerate(sys.argv[1:], 1)
        ):
            raise Refused("Arguments exceed bounds")
        if len(sys.argv) > 1 and sys.argv[1] not in read_ops and os.geteuid() != 0:
            raise Refused("This operation requires authorization")
        if len(sys.argv) > 1 and sys.argv[1] == "status-live" and os.geteuid() != 0:
            raise Refused("Live WMI status requires authorization")
        audit("start", sys.argv[1:])
        result = Controller(
            Hardware(), rollback_deadline=lambda: signal.alarm(10)
        ).execute(sys.argv[1:])
    except (OSError, Refused) as error:
        result = {
            "ok": False,
            "protocolVersion": PROTOCOL_VERSION,
            "applied": False,
            "error": str(error)[:512],
            "rollback": {
                "attempted": None,
                "ok": None,
                "error": "Transaction outcome unavailable",
            },
        }
    audit("finish", sys.argv[1:], result)
    signal.alarm(0)
    encoded = json.dumps(result, separators=(",", ":"), allow_nan=False)
    if len(encoded) > 65536:
        encoded = json.dumps(
            {
                "ok": False,
                "protocolVersion": PROTOCOL_VERSION,
                "error": "Output exceeded bound",
            }
        )
    print(encoded)
    sys.exit(0 if result.get("ok") else 1)
