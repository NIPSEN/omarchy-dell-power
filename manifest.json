      },
      {
        "key": "powerFlowVisible",
        "type": "boolean",
        "label": "powerFlowVisible"
      },
      {
        "key": "automationEnabled",
        "type": "boolean",
        "label": "automationEnabled"
      },
      {
        "key": "automationVisible",
        "type": "boolean",
        "label": "automationVisible"
      },
      {
        "key": "saverEnabled",
        "type": "boolean",
        "label": "saverEnabled"
      },
      {
        "key": "saverVisible",
        "type": "boolean",
        "label": "saverVisible"
      },
      {
        "key": "brightnessEnabled",
        "type": "boolean",
        "label": "brightnessEnabled"
      },
      {
        "key": "brightnessVisible",
        "type": "boolean",
        "label": "brightnessVisible"
      }
